<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ACTIVAR CONTEXTO JERÁRQUICO SOLO EN 'DOCUMENTOS > ARCHIVOS' -->
    <!-- (Con esto evito que en salgan archivos duplicados en el árbol de archivos) -->
    <record id="dms.action_dms_file" model="ir.actions.act_window">
        <field name="context">{'ifdw_hierarchical_files': True}</field>
    </record>

    <!-- VISTA LISTA (LIST VIEW) DE AUTOMATIZACIÓN DMS -->
    <record id="view_ifdw_dms_automation_list" model="ir.ui.view">
        <field name="name">ifdw.dms.automation.list</field>
        <field name="model">ifdw.dms.automation</field>
        <field name="arch" type="xml">
            <list string="Automatización DMS">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="template_id"/>
                <field name="storage_id"/>
                <field name="model_id"/>
                <field name="auto_clone_on_create" widget="boolean_toggle"/>
                <field name="show_smart_button" widget="boolean_toggle"/>
                <field name="enable_file_movement" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- VISTA FORMULARIO (FORM VIEW) DE AUTOMATIZACIÓN DMS -->
    <record id="view_ifdw_dms_automation_form" model="ir.ui.view">
        <field name="name">ifdw.dms.automation.form</field>
        <field name="model">ifdw.dms.automation</field>
        <field name="arch" type="xml">
            <form string="Automatización DMS">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_dummy_preview_smart_button"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-folder-open-o"
                                invisible="not show_smart_button"
                                title="Muestra visual de cómo se verá el botón inteligente en los formularios (Botón de vista previa sin actividad)">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">Muestra</span>
                                <span class="o_stat_text">Documentos</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>

                    <div class="oe_title">
                        <label for="name" string="Nombre de la Regla de Automatización"/>
                        <h1>
                            <field name="name" placeholder="Ej. Archivos de CRM / Archivos de Proyectos"/>
                        </h1>
                    </div>

                    <!-- CABECERA DEL FORMULARIO -->
                    <group>
                        <group string='Seleccionar "Plantilla DMS embeb."'>
                            <field name="active" invisible="1"/>
                            <field name="model_name" invisible="1"/>
                            <field name="in_source_root_dir_id" invisible="1"/>
                            <field name="in_dest_root_dir_id" invisible="1"/>
                            <field name="in_dest_model_id" invisible="1"/>
                            <field name="out_source_root_dir_id" invisible="1"/>
                            <field name="out_dest_root_dir_id" invisible="1"/>
                            <field name="out_dest_model_id" invisible="1"/>
                            <field name="template_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="storage_id" readonly="1"/>
                            <field name="model_id" readonly="1"/>
                            <field name="group_ids" widget="many2many_tags" readonly="1"/>
                            <field name="template_root_dir_id" readonly="1"/>
                        </group>

                        <group string="Opciones y comportamiento generales">
                            <field name="auto_clone_on_create"/>
                            <field name="filter_domain"
                                   widget="domain"
                                   options="{'model': 'model_name', 'in_dialog': True}"
                                   invisible="not auto_clone_on_create"/>
                            <field name="show_smart_button"/>
                            <field name="auto_rename_chatter"/>
                            <field name="rename_format"
                                   invisible="not auto_rename_chatter"
                                   required="auto_rename_chatter"/>
                            <field name="filter_small_images"/>
                            <field name="min_image_size_kb"
                                   invisible="not filter_small_images"
                                   required="filter_small_images"/>
                            <field name="sync_unlink_chatter"/>
                        </group>
                    </group>

                    <!-- LAS 3 PESTAÑAS DE LAS REGLAS -->
                    <notebook>
                        <!-- Reg. Chatter Auto-clasific. -->
                        <page string="Reg. Chatter Auto-clasific." name="tab_chatter_classify">
                            <div class="d-flex justify-content-between align-items-center my-2">
                                <span class="text-muted">
                                    Define qué tipos de archivos subidos al Chatter irán a cada subcarpeta de la Plantilla DMS embebida seleccionada y qué Categoría se les asignará. Al clasificar, dejará una nota agrupada en el Chatter del registro donde se subió.
                                </span>
                                <button name="action_reload_template_subfolders"
                                        type="object"
                                        string="Sincronizar subcarpetas de la plantilla"
                                        icon="fa-refresh"
                                        class="btn-secondary btn-sm"
                                        help="Pulsa aquí si has añadido subcarpetas nuevas en tu Plantilla DMS embebida para cargarlas automáticamente en esta lista."/>
                            </div>
                            <field name="classify_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="template_root_dir_id" column_invisible="True"/>
                                    <field name="template_subdir_id"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                    <field name="file_type_rule"/>
                                    <field name="filename_keywords" placeholder="Ej: plano, croquis, medicion"/>
                                    <field name="custom_extensions" optional="show" placeholder="Ej: bc3, plt"/>
                                    <field name="category_id"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                </list>
                            </field>
                        </page>

                        <!-- Reg. Mod. Auto-clasific. -->
                        <page string="Reg. Mod. Auto-clasific." name="tab_satellite_models">
                            <p class="text-muted my-2">
                                Añade aquí otros modelos secundarios de Odoo (por ejemplo <strong>Tareas</strong>, <strong>Pedidos de Venta</strong> o <strong>Facturas</strong>) para que los archivos que se suban a sus Chatters se guarden automáticamente dentro de la carpeta del registro principal al que están unidos.
                            </p>
                            <field name="satellite_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="parent_model_id" column_invisible="True"/>
                                    <field name="parent_model_name" column_invisible="True"/>
                                    <field name="template_root_dir_id" column_invisible="True"/>
                                    <field name="satellite_model_id"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="link_field_id"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="force_subdir_id"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                    <field name="auto_tag_record_name"/>
                                </list>
                            </field>
                        </page>

                        <!-- Reg. Mov. Archiv. (Espejo Bidireccional con Canales Separados -->
                        <page string="Reg. Mov. Archiv." name="tab_file_movement">
                            <p class="text-muted my-2">
                                Configura el traspaso o copia de archivos entre almacenamientos (por ejemplo, <strong>CRM ➔ Proyectos ➔ Administración</strong>). Funciona en <strong>Espejo Bidireccional con canales independientes de Entrada y Salida</strong>: una regla intermedia puede recibir archivos de un Origen y enviar a otro Destino sin que sus tablas de mapeo se pisen.
                            </p>
                            <group>
                                <group>
                                    <field name="enable_file_movement"/>
                                    <field name="movement_role"
                                           invisible="not enable_file_movement"
                                           required="enable_file_movement"/>
                                </group>
                            </group>

                            <!-- BLOQUE CANAL DE ENTRADA (as_dest) -->
                            <group invisible="not enable_file_movement or movement_role != 'as_dest'"
                                   string="Canal de Entrada: Recibir Archivos desde Regla de Origen">
                                <group>
                                    <field name="source_automation_id"
                                           required="enable_file_movement and movement_role == 'as_dest'"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="origin_link_field_id"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group>
                                    <field name="after_move_action"
                                           required="enable_file_movement and movement_role == 'as_dest'"/>
                                    <field name="post_chatter_summary"/>
                                    <field name="trace_model_ids"
                                           widget="many2many_tags"
                                           invisible="not post_chatter_summary"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                            </group>

                            <separator string="Mapeo de Subcarpetas de Entrada (Origen -> Este Modelo)"
                                       invisible="not enable_file_movement or movement_role != 'as_dest'"/>
                            <field name="movement_in_line_ids"
                                   invisible="not enable_file_movement or movement_role != 'as_dest'"
                                   context="{'default_channel_role': 'as_dest'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="channel_role" column_invisible="True"/>
                                    <field name="source_root_dir_id" column_invisible="True"/>
                                    <field name="dest_root_dir_id" column_invisible="True"/>
                                    <field name="source_subdir_id"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                    <field name="dest_subdir_id"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                </list>
                            </field>

                            <!-- BLOQUE CANAL DE SALIDA (as_source) -->
                            <group invisible="not enable_file_movement or movement_role != 'as_source'"
                                   string="Canal de Salida: Enviar Archivos hacia Regla de Destino">
                                <group>
                                    <field name="dest_automation_id"
                                           required="enable_file_movement and movement_role == 'as_source'"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="out_origin_link_field_id"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group>
                                    <field name="out_after_move_action"
                                           required="enable_file_movement and movement_role == 'as_source'"/>
                                    <field name="out_post_chatter_summary"/>
                                    <field name="out_trace_model_ids"
                                           widget="many2many_tags"
                                           invisible="not out_post_chatter_summary"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                            </group>

                            <separator string="Mapeo de Subcarpetas de Salida (Este Modelo -> Destino)"
                                       invisible="not enable_file_movement or movement_role != 'as_source'"/>
                            <field name="movement_out_line_ids"
                                   invisible="not enable_file_movement or movement_role != 'as_source'"
                                   context="{'default_channel_role': 'as_source'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="channel_role" column_invisible="True"/>
                                    <field name="source_root_dir_id" column_invisible="True"/>
                                    <field name="dest_root_dir_id" column_invisible="True"/>
                                    <field name="source_subdir_id"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                    <field name="dest_subdir_id"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACCIÓN DE VENTANA Y SUBMENÚ EN CONFIGURACIÓN > ORGANIZAR -->
    <record id="action_ifdw_dms_automation" model="ir.actions.act_window">
        <field name="name">Automatización DMS</field>
        <field name="res_model">ifdw.dms.automation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera regla de Automatización DMS
            </p>
            <p>
                Conecta tus <strong>Plantillas DMS embebidas</strong> para automatizar el clonado de carpetas, los botones inteligentes Documentos, la auto-clasificación desde el clip del Chatter y el traspaso en espejo entre almacenamientos.
            </p>
        </field>
    </record>

    <menuitem id="menu_ifdw_dms_automation"
              name="Automatización DMS"
              parent="dms.cat_menu_dms_config"
              action="action_ifdw_dms_automation"
              sequence="12"
              groups="dms.group_dms_manager,base.group_system"/>
</odoo>
