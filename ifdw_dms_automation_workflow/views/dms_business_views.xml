<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pestaña "Ops. Documentos" en el formulario de CRM (crm.lead) -->
    <record id="view_crm_lead_form_ifdw_dms" model="ir.ui.view">
        <field name="name">crm.lead.form.ifdw.dms</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Ops. Documentos" name="ifdw_dms_ops_page" invisible="type == 'lead'">
                    <group string="Política de Traspaso Documental hacia Proyectos (Obras)">
                        <div class="text-muted mb-2" colspan="2">
                            <i class="fa fa-info-circle me-1"/>
                            Define qué debe ocurrir con los archivos de esta Oportunidad cuando apruebes un Presupuesto adicional o de ampliación y se genere un segundo Proyecto.
                        </div>
                        <field name="ifdw_project_transfer_policy" widget="radio"/>
                    </group>
                    <group string="Historial de Traspasos Realizados desde esta Oportunidad">
                        <field name="ifdw_transfer_log_ids" nolabel="1" colspan="2">
                            <list create="0" edit="0" delete="0">
                                <field name="transfer_date"/>
                                <field name="sale_order_id"/>
                                <field name="project_id"/>
                                <field name="files_count"/>
                                <field name="operation_mode"/>
                                <field name="crm_policy_used"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
