#: model_terms:ir.ui.view,arch_db:ifdw_dms_automation_workflow.view_ifdw_dms_automation_form
msgid "Pulsa aquí si has añadido subcarpetas nuevas en tu Plantilla DMS embebida para cargarlas automáticamente en esta lista."
msgstr "Click here if you have added new subfolders to your Embedded DMS Template to load them automatically into this list."

#: model_terms:ir.ui.view,arch_db:ifdw_dms_automation_workflow.view_ifdw_dms_automation_form
msgid "Ej: plano, croquis, medicion"
msgstr "E.g.: plan, sketch, measurement"

#: model_terms:ir.ui.view,arch_db:ifdw_dms_automation_workflow.view_ifdw_dms_automation_form
