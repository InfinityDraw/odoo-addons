<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="pwa_res_config_settings_view_form_title" model="ir.ui.view">
            <field name="name">res.config.settings.web.window.title</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='languages']" position="after">
                    <div>
                        <block title="PWA" id="pwa">
                            <setting help="Este nombre se utilizará para el título del navegador.">
                                <group>
                                    <field name="pwa_name" style="width:100%"/>
                                    <field name="pwa_short_name" style="width:100%"/>
                                    <field name="pwa_background_color" style="width:100%"/>
                                    <field name="pwa_theme_color" style="width:100%"/>
                                    <field name="pwa_icon" widget="image" class="float-left oe_avatar" style="width:100%"/>
                                </group>
                            </setting>
                            <setting>
                                <group>
                                    <field name="push_notification"/>
                                    <field name="firebase_config_file" required="push_notification==True"
                                           invisible="push_notification == False" style="width:100%"/>
                                    <field name="vapid_private_key" required="push_notification==True"
                                           invisible="push_notification == False" style="width:100%"/>
                                    <field name="vapid_public_key" required="push_notification==True"
                                           invisible="push_notification == False" style="width:100%"/>
                                    <field name="fcm_api_url" invisible="1" style="width:100%"/>
                                    <div class="text-muted" invisible="push_notification == False">
                                        <h2>Instrucciones para obtener las claves VAPID:</h2>
                                        <ol>
                                            <li>Ve a la consola de Firebase (<a href="https://console.firebase.google.com/" target="_blank">https://console.firebase.google.com/</a>).</li>
                                            <li>Selecciona tu proyecto.</li>
                                            <li>Ve a "Configuración del proyecto" -> "Cloud Messaging".</li>
                                            <li>En la sección "Configuración web", encontrarás las claves VAPID públicas y privadas.</li>
                                            <li>Copia las claves y pégalas en los campos correspondientes a continuación.</li>
                                        </ol>
                                    </div>
                                    <button name="test_connection"
                                            string="Probar conexión"
                                            type="object" class="btn btn-primary"
                                            invisible="push_notification == False"/>
                                </group>
                            </setting>
                        </block>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
