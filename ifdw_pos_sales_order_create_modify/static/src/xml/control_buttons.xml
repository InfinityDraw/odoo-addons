<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ifdw_pos_sales_order_create_modify.CreateSaleOrderButton" t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
            <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton" position="after">
                <button t-if="create_sale_order"
                        t-att-class="buttonClass"
                        t-on-click="() => this.OnCreateSaleOrderPopup()">
                    <i class="fa fa-th-list me-2" role="img"
                       aria-label="Create Sale/Reservation Order"
                       title="Create Sale/Reservation Order"/>
                    Create SO
                </button>

                <button t-if="update_sale_order"
                        t-att-class="buttonClass"
                        t-on-click="() => this.OnUpdateSaleOrderPopup()">
                    <i class="fa fa-th-list me-2" role="img" aria-label="Update Order" title="Update Order"/>
                    Update SO
                </button>

            </xpath>
    </t>
</templates>
