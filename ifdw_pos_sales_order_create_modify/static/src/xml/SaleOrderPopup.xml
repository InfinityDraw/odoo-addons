<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="ifdw_pos_sales_order_create_modify.SaleOrderPopup">
        <Dialog title="props.title">
            <main class="modal-body">
                <div style="text-align:center !important;">
                     <label class="info-title" for="note">Notes</label>
                    <div class="mb-3">
                        <div class="cash-input-sub-section input-group">
                            <input type="text"
                                   name="note"
                                   id="note"
                                   class="pos-input form-control text-input"
                                   t-on-change="OnChange"
                                   t-att-value="changes.note"/>
                        </div>
                    </div>
                </div>
                <div style="text-align:center !important;" class="client-details-right">
                    <p t-if="changes.sale_order_auto_confirm and changes.sale_order_auto_invoice">Partial Payment</p>
                    <div class="mb-3" t-if="changes.sale_order_auto_confirm and changes.sale_order_auto_invoice">
                        <label class="info-title d-flex flex-grow-1 align-items-start"
                               for="payment_partial_amount">Partial Amount</label>
                        <div class="cash-input-sub-section input-group">
                            <input class="pos-input form-control"
                                   t-on-change="OnChange"
                                   t-ref="payment_partial_amount"
                                   name="payment_partial_amount"
                                   id="payment_partial_amount"
                                   t-att-value="changes.payment_partial_amount"
                                   type="number"/>
                        </div>
                    </div>
                    <div class="mb-3"
                         t-if="pos.config.payment_method_ids and changes.sale_order_auto_confirm and changes.sale_order_auto_invoice">
                        <label class="info-title d-flex flex-grow-1 align-items-start"
                               for="payment_partial_method_id">Partial Payment Method</label>
                        <div class="cash-input-sub-section input-group">
                            <select class="form-control" name="payment_partial_method_id" id="payment_partial_method_id"
                                    t-on-change="OnChange">
                                <t t-foreach="pos.config.payment_method_ids" t-as="method" t-key="method.id">
                                    <option t-att-value="method.id"
                                            t-att-selected="method['id'] ? ((changes.payment_partial_method_id and method.id === changes.payment_partial_method_id) ? true : undefined) : undefined">
                                        <t t-esc="method.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3" t-if="props.pricelists">
                        <label class="info-title d-flex flex-grow-1 align-items-start"
                               for="pricelist_id">Pricelist</label>
                        <div class="cash-input-sub-section input-group">
                            <select class="form-control" name="pricelist_id" id="pricelist_id" t-on-change="OnChange">
                                <t t-foreach="props.pricelists" t-as="pricelist" t-key="pricelist.id">
                                    <option t-att-value="pricelist.id"
                                            t-att-selected="pricelist['id'] ? ((changes.pricelist_id and pricelist.id === changes.pricelist_id) ? true : undefined) : undefined">
                                        <t t-esc="pricelist.label"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </div>
                    <!--                    <div class="mb-3" t-if="pos.config.sale_order_required_signature"-->
                    <!--                         style="text-align:center !important;">-->
                    <!--                        <span class="info-title d-flex flex-grow-1 align-items-start">Signature</span>-->
                    <!--                        <div class="cash-input-sub-section text-input" t-ref="signature-div" name="signature"-->
                    <!--                             t-on-change="OnChange"/>-->
                    <!--                    </div>-->
                    <div style="text-align:center !important;">
                        <p class="info-title">Automatic Actions</p>
                        <div class="mb-3">
                            <div class="cash-input-sub-section input-group">
                                <label class="info-title d-flex flex-grow-1 align-items-start"
                                       for="sale_order_auto_confirm">Auto Confirm</label>
                                <input type="checkbox"
                                       name="sale_order_auto_confirm"
                                       id="sale_order_auto_confirm"
                                       t-on-change="OnChange"
                                       t-att-checked="changes.sale_order_auto_confirm"
                                       class="checkbox">
                                </input>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="cash-input-sub-section input-group">
                                <label class="info-title d-flex flex-grow-1 align-items-start"
                                       for="sale_order_auto_delivery">Auto Delivery</label>
                                <input type="checkbox"
                                       name="sale_order_auto_delivery"
                                       id="sale_order_auto_delivery"
                                       t-on-change="OnChange"
                                       t-att-checked="changes.sale_order_auto_delivery"
                                       class="checkbox">
                                </input>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="cash-input-sub-section input-group">
                                <label class="info-title d-flex flex-grow-1 align-items-start"
                                       for="sale_order_auto_invoice">Auto Invoice</label>
                                <input type="checkbox"
                                       name="sale_order_auto_invoice"
                                       id="sale_order_auto_invoice"
                                       t-on-change="OnChange"
                                       t-att-checked="changes.sale_order_auto_invoice"
                                       class="checkbox">
                                </input>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
            <t t-set-slot="footer">
                <button t-if="props.order_state == 'create'"
                        class="button confirm highlight btn btn-lg btn-primary"
                        t-on-click="OnConfirmCreateSO">
                    Create SO
                </button>
                <button t-if="props.order_state == 'update'"
                        class="button confirm highlight btn btn-lg btn-primary"
                        t-on-click="OnConfirmUpdateSO">
                    Update SO
                </button>
                <button class="button cancel btn btn-lg btn-secondary" t-on-click="props.close"
                        t-out="props.cancelText"/>
            </t>
        </Dialog>
    </t>

</templates>