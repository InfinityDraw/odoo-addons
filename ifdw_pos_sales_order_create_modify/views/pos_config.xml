<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="view_inherit_pos_config_form" model="ir.ui.view">
            <field name="name">view.inherit.pos.config.form</field>
            <field name="model">pos.config</field>
            <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
            <field name="arch" type="xml">


                <xpath expr="//sheet/div[4]/div" position="before">

                    <setting id="sales_order">
                        <group>
                            <field name="create_sale_order"/>
                            <field name="update_sale_order"/>
                        </group>
                        <group invisible="not create_sale_order and not update_sale_order">
                            <field name="sale_order_required_signature"/>
                            <field name="sale_order_auto_confirm"/>
                            <field name="sale_order_auto_delivery"/>
                            <field name="sale_order_auto_invoice"/>
                        </group>
                    </setting>
                </xpath>

            </field>
        </record>


    </data>
</odoo>